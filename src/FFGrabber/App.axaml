<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FFGrabber.App"
             xmlns:styling="clr-namespace:FluentAvalonia.Styling;assembly=FluentAvalonia"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <styling:FluentAvaloniaTheme UseSystemFontOnWindows="True" CustomAccentColor="#C2F970" />
    <Style Selector="TextBlock.pageTitle"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#F5F6FA"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#9EA4B3"/></Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="#191B23"/><Setter Property="BorderBrush" Value="#2D303B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="14"/></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="34"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#C2F970"/><Setter Property="Foreground" Value="#13170B"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBox"><Setter Property="Background" Value="#111319"/><Setter Property="BorderBrush" Value="#343846"/><Setter Property="Foreground" Value="#F1F3F8"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="9,7"/></Style>
    <Style Selector="ComboBox"><Setter Property="Background" Value="#111319"/><Setter Property="BorderBrush" Value="#343846"/><Setter Property="Foreground" Value="#F1F3F8"/><Setter Property="CornerRadius" Value="7"/></Style>
  </Application.Styles>
</Application>
