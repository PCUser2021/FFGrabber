<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FFGrabber.App"
             xmlns:styling="clr-namespace:FluentAvalonia.Styling;assembly=FluentAvalonia"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <styling:FluentAvaloniaTheme UseSystemFontOnWindows="True" CustomAccentColor="#C2F970" />
    <Style Selector="TextBlock.pageTitle"><Setter Property="FontSize" Value="31"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#F5F7FC"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#B1B8C8"/></Style>
    <Style Selector="Border.heroPanel"><Setter Property="Background" Value="#C8171D28"/><Setter Property="BorderBrush" Value="#5CFFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="22"/></Style>
    <Style Selector="Border.brandMark"><Setter Property="Background" Value="#E6C2F970"/><Setter Property="BorderBrush" Value="#FFC2F970"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="15"/><Setter Property="Width" Value="54"/><Setter Property="Height" Value="54"/></Style>
    <Style Selector="Border.tagPill"><Setter Property="Background" Value="#3822C879"/><Setter Property="BorderBrush" Value="#7222C879"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="10,5"/></Style>
    <Style Selector="Border.statusPanel"><Setter Property="Background" Value="#8D18212B"/><Setter Property="BorderBrush" Value="#668DA99D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="13"/><Setter Property="Padding" Value="14,11"/></Style>
    <Style Selector="Border.glassShell"><Setter Property="Background" Value="#35101620"/><Setter Property="BorderBrush" Value="#40FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Padding" Value="20"/></Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="#B51A202B"/><Setter Property="BorderBrush" Value="#4DFFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="17"/><Setter Property="Padding" Value="17"/></Style>
    <Style Selector="Button"><Setter Property="Background" Value="#8F252C39"/><Setter Property="Foreground" Value="#F1F4FA"/><Setter Property="BorderBrush" Value="#4DFFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="11"/><Setter Property="Padding" Value="13,9"/><Setter Property="MinHeight" Value="38"/><Setter Property="FontWeight" Value="Medium"/></Style>
    <Style Selector="Button:pointerover"><Setter Property="Background" Value="#C9333D4E"/><Setter Property="BorderBrush" Value="#88C2F970"/></Style>
    <Style Selector="Button:pressed"><Setter Property="Background" Value="#E52B3442"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#FFC2F970"/><Setter Property="Foreground" Value="#FF12170B"/><Setter Property="BorderBrush" Value="#FFC2F970"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.primary:pointerover"><Setter Property="Background" Value="#FFD4FF94"/><Setter Property="BorderBrush" Value="#FFD4FF94"/></Style>
    <Style Selector="TextBox"><Setter Property="Background" Value="#7810141D"/><Setter Property="BorderBrush" Value="#51FFFFFF"/><Setter Property="Foreground" Value="#F1F3F8"/><Setter Property="CaretBrush" Value="#C2F970"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="10,8"/></Style>
    <Style Selector="TextBox:focus"><Setter Property="BorderBrush" Value="#FFC2F970"/></Style>
    <Style Selector="ComboBox"><Setter Property="Background" Value="#8F141923"/><Setter Property="BorderBrush" Value="#51FFFFFF"/><Setter Property="Foreground" Value="#F1F3F8"/><Setter Property="CornerRadius" Value="9"/></Style>
    <Style Selector="ListBox"><Setter Property="Background" Value="#5510141D"/><Setter Property="BorderBrush" Value="#45FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/></Style>
    <Style Selector="Expander"><Setter Property="Background" Value="#4C171C26"/><Setter Property="BorderBrush" Value="#45FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="13"/><Setter Property="Padding" Value="12"/></Style>
    <Style Selector="CheckBox"><Setter Property="Foreground" Value="#E9EDF5"/></Style>
  </Application.Styles>
</Application>
